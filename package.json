{
	"name": "opencode-english-prompt-polisher",
	"version": "1.0.0",
	"description": "OpenCode plugin that proposes polished English versions of user prompts.",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Relz/opencode-english-prompt-polisher.git"
	},
	"bugs": {
		"url": "https://github.com/Relz/opencode-english-prompt-polisher/issues"
	},
	"homepage": "https://github.com/Relz/opencode-english-prompt-polisher#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "tsc -p tsconfig.build.json",
		"format": "prettier --write src tests",
		"format:check": "prettier --check src tests",
		"lint": "eslint src tests --ext .ts --max-warnings=0",
		"lint:fix": "npm run lint -- --fix",
		"prepack": "npm run build",
		"spell:check": "cspell --no-progress --dot .",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-strip-types --experimental-test-module-mocks 'tests/**/*.test.ts'"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"opencode",
		"plugin",
		"english",
		"prompt",
		"notion"
	],
	"author": "Relz",
	"engines": {
		"node": ">=24.18.0",
		"opencode": ">=2.0.26"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.0",
		"@typescript-eslint/utils": "^8.62.1",
		"cspell": "^10.0.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"effect": "4.0.0-rc.112",
		"prettier": "^3.9.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	},
	"dependencies": {
		"@opencode/plugin": "^2.0.26",
		"@opencode/schema": "^2.0.26",
		"english-prompt-polisher": "^2.0.0"
	},
	"peerDependencies": {
		"effect": "4.0.0-rc.112"
	}
}
